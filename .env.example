# Copia este fichero a .env (que está en .gitignore, nunca se publica) y
# rellena tu clave real. Clave gratuita e inmediata en:
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Opcional — logos de empresa en el dashboard (ver CONTEXTO.md, "Logos de
# empresa en el dashboard"). Sin esto, el dashboard funciona igual, solo
# no muestra logos. Clave gratuita (sin tarjeta) en:
# https://www.logo.dev/signup
LOGO_DEV_TOKEN=

# Opcional — chat experto de la página "Contenido Premium" (ver
# CONTEXTO.md, "Chat experto sobre earnings: viabilidad y diseño"). Sin
# esto, esa página funciona igual, solo el chat queda deshabilitado con
# un aviso. A DIFERENCIA de las claves de arriba, esta SÍ es secreta y
# tiene coste por uso (facturación en la cuenta de Anthropic) — nunca la
# subas a git ni la compartas. Clave en:
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Opcional — solo si al usar el chat te da el error 400
# "anthropic-workspace-id is required when authenticating with an
# identity-linked API key" (pasa con claves personales/de service account
# no ligadas a un workspace concreto al crearlas). El ID del workspace
# está en Claude Console > Settings > Workspaces > columna "ID"
# (`wrkspc_...`). Si no te ha dado ese error, déjalo vacío.
ANTHROPIC_WORKSPACE_ID=
